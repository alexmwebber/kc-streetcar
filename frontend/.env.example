# Base URL of the backend API.
# Leave empty for local dev: requests stay relative and Vite proxies /api to
# localhost:3001 (see vite.config.ts).
# For production builds, set to the deployed Azure Container Apps URL, e.g.
#   https://kc-streetcar-api.<hash>.eastus2.azurecontainerapps.io
VITE_API_BASE_URL=
