# Swiftly GTFS-RT feed
# Rate limit: 180 requests/15min. Production alone uses ~120 of those (2 feeds
# every 15s) - stop this local backend when you're done or you'll go over. See
# README.md "Stop the backend when you're done developing".
SWIFTLY_API_KEY=replace-me
GTFS_RT_BASE_URL=https://api.goswift.ly/real-time/kcata
STREETCAR_ROUTE_ID=601

# Polling
POLL_INTERVAL_MS=15000

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgres://streetcar:streetcar@localhost:5432/streetcar

# API server
PORT=3001
